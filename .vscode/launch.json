  "version": "0.2.0",
  "configurations": [
    {
      "name": "Attach to Backend (API)",
      "type": "go",
      "request": "attach",
      "mode": "remote",
      "port": 2345,
      "substitutePath": [
        {
          "from": "/workspaces/husonym/",
          "to": "/workspace/"
        }
      ],
      "host": "127.0.0.1"
    },
    {
      "name": "Attach to Worker",
      "type": "go",
      "request": "attach",
      "mode": "remote",
      "port": 2346,
      "substitutePath": [
        {
          "from": "/workspaces/husonym/",
          "to": "/workspace/"
        }
      ],
      "host": "127.0.0.1"
    }
  ]
}
