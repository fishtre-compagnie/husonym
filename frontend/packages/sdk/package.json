{
  "name": "@husonym/sdk",
  "version": "0.0.0",
  "description": "Husonym SDK",
  "private": false,
  "files": [
    "dist/**"
  ],
  "main": "./dist/index.cjs",
  "types": "./dist/index.d.cts",
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 0",
    "clean": "rm -rf dist && rm -rf .turbo",
    "build": "tsup src/index.ts --format cjs,esm --dts",
    "dev": "tsup src/index.ts --format esm,cjs --dts --watch",
    "lint": "eslint 'src/**/*.{js,ts,tsx}'",
    "typecheck": "tsc --noEmit"
  },
  "author": "Fishtre Compagnie",
  "license": "MIT",
  "devDependencies": {
    "tsup": "^8.5.1"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.14.0",
    "@connectrpc/connect": "^2.1.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fishtre-compagnie/husonym.git"
  },
  "keywords": [
    "husonym",
    "sdk"
  ],
  "bugs": {
    "url": "https://github.com/fishtre-compagnie/husonym/issues"
  },
  "homepage": "https://github.com/fishtre-compagnie/husonym#readme"
}
